  </ImportGroup>
  <!-- Declarative copy of runtime dependencies (DLLs + info.db for FixCr3).
       These will be copied to $(OutDir) with "PreserveNewest" semantics by MSBuild itself.
       This is more reliable than (or in addition to) PostBuildEvent. 
       The files must exist in $(SolutionDir)resources\ at build time. -->
  <ItemGroup>
    <None Include="$(SolutionDir)resources\leechcore.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)resources\vmm.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)resources\FTD3XX.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)resources\dbghelp.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)resources\symsrv.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)resources\info.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)resources\vmmyara.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>